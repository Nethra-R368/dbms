# SmartHostel Environment Configuration Template
# Copy this file to .env and replace placeholders with your credentials

# Local PostgreSQL database connection:
DATABASE_URL=postgresql://postgres:<your_password>@localhost:5432/smarthostel

# Azure Database for PostgreSQL (Flexible Server):
# DATABASE_URL=postgresql://<admin_user>:<password>@<server-name>.postgres.database.azure.com:5432/smarthostel?sslmode=require

# AWS RDS PostgreSQL:
# DATABASE_URL=postgresql://<admin_user>:<password>@<rds-endpoint>:5432/smarthostel?sslmode=require

# Security & Server Settings
JWT_SECRET=your_super_secret_jwt_key_here
PORT=8000
HOST=127.0.0.1
